/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    VF & ARG Detection Pipeline - Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

plugins {
    id 'nf-schema@2.3.0'
}

params {
    // Input/output
    input   = null
    outdir  = 'results'

    // VF detection
    vf_db          = 'vfdb'           // ABRicate database for VF detection
    vf_min_id      = 80               // Minimum identity (%) for VF hits
    vf_min_cov     = 80               // Minimum coverage (%) for VF hits

    // ARG detection
    arg_tool       = 'abricate'       // Tool for ARG detection: 'abricate' or 'amrfinderplus'
    arg_db         = 'card'           // ABRicate database for ARG detection: 'card', 'resfinder', 'ncbi', 'argannot'
    arg_min_id     = 80               // Minimum identity (%) for ARG hits
    arg_min_cov    = 80               // Minimum coverage (%) for ARG hits
}

// Process resource defaults
process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    withLabel: 'process_single' {
        cpus   = 1
        memory = '2.GB'
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = '8.GB'
        time   = '2.h'
    }
}

// Profiles
profiles {
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }
    test {
        params.input  = "${projectDir}/tests/data/samplesheet.csv"
        params.outdir = "${projectDir}/tests/results"
    }
}

// Include modules config
includeConfig 'conf/modules.config'

// Capture execution info
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}

// Manifest
manifest {
    name            = 'anoda'
    author          = 'ha7332296-design'
    description     = 'Detect Virulence Factors (VF) and Antimicrobial Resistance Genes (ARGs) from MAGs'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
}
